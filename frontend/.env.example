# Health Garden — web client environment variables.
#
# Copy to `.env.local` (git-ignored) for local development:
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed VITE_ to client code (by design —
# never put a secret here, this bundle ships to the browser). Both values
# below are safe to expose: the anon key is meant to be public and carries no
# privilege beyond what Row Level Security grants an unauthenticated/JWT'd
# request (see supabase/migrations for the RLS policies that actually gate
# access).

# Supabase project URL and anon (publishable) key.
# Find both under Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (public — safe to expose), used on the
# Premium/pricing screen's manual-payment form (payments-submit-intent
# requires a verified token — see supabase/functions/_shared/security/turnstile.ts).
# Get one at https://dash.cloudflare.com/?to=/:account/turnstile — free tier.
# Optional: the app boots and runs fully without this; only payment
# submission is unavailable until it's set.
VITE_TURNSTILE_SITE_KEY=

# Web Push VAPID public key — the same key pair as the root .env.example's
# VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY (`npx web-push generate-vapid-keys`).
# Only the public half belongs here; it's meant to be exposed (see
# lib/env.ts's doc comment) and can't sign anything on its own.
# Optional: the app boots and runs fully without this; the "enable
# reminders" prompt just never appears until it's set.
VITE_VAPID_PUBLIC_KEY=

# PostHog (client-side event capture) and Sentry (client-side error
# reporting) -- same accounts/keys as the root .env.example's
# POSTHOG_API_KEY/POSTHOG_HOST/SENTRY_DSN (Blueprint ADR-013). Optional:
# lib/observability/{posthog,sentry}.ts degrade to a silent no-op without
# these, exactly like every other optional integration above.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
