# =============================================================================
# Health Garden — Environment Configuration Template
# =============================================================================
# Copy to `.env` for tooling, and to `supabase/functions/.env.local` for local
# Edge Function development. NEVER commit the populated files (Blueprint §7.4).
#
# Secret classification (Blueprint §7.4, §9.4):
#   PUBLIC  — safe to ship inside the web client bundle
#   SECRET  — server-side only; must never reach a browser
# =============================================================================

# --- Supabase platform -------------------------------------------------------
# PUBLIC: designed to be embedded in the client; access is governed by RLS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key-from-`supabase status`

# SECRET: bypasses ALL Row Level Security. Edge Functions only. Never client-side.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-`supabase status`

# SECRET: direct Postgres connection, used only by the database test suite
# (supabase/tests/database/) for white-box assertions that must bypass RLS.
DATABASE_URL=replace-with-local-db-url-from-`supabase status`

# --- Google Gemini (premium AI tier only — Blueprint §6.2, §6.6, ADR-003/022) --
# SECRET: an exposed key allows anyone to consume the project-wide free quota.
# Consumed only through the AiProvider abstraction (§6.6) — never called directly.
GEMINI_API_KEY=
# PUBLIC-ish (a model name, not a credential); optional, defaults to gemini-3.5-flash.
# gemini-2.0-flash (the previous default) was retired 1 June 2026 — verify this
# default against https://ai.google.dev/gemini-api/docs/deprecations periodically.
GEMINI_MODEL=

# --- Cloudflare Turnstile (bot/abuse protection — Blueprint §7.12, G-20) ------
# PUBLIC (site key) / SECRET (verification key) — Turnstile follows the same
# public/secret split as reCAPTCHA. Consumed by payments-submit-intent (Phase 5);
# the web client's signup form is the other caller, once it exists.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin allowlist (payments-approve-intent — Blueprint §6.2, ADR-0025) -----
# PUBLIC-ish (email addresses, not credentials) but keep out of client bundles
# regardless — this is who can approve real money. Comma-separated, case-insensitive.
ADMIN_EMAILS=

# --- JazzCash Mobile Wallet (real-time checkout — ADR-0028) -------------------
# SECRET: obtained from JazzCash directly after merchant onboarding/KYC —
# never fabricated or substituted with placeholder-looking values, and never
# pasted into a chat session. Set via `supabase secrets set`, not committed.
# JAZZCASH_MODE selects sandbox vs. production explicitly (never inferred
# from APP_ENV) so a misconfigured deploy cannot silently start charging
# real cards — see `_shared/payments/jazzcash.ts`.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# One of: sandbox | production
JAZZCASH_MODE=sandbox
# PUBLIC-ish (not a secret, but must be this deployment's real callback URL
# for the hash JazzCash echoes back to line up) — where JazzCash's hosted
# checkout page POSTs its result. Point this at
# `${SUPABASE_URL}/functions/v1/payments-jazzcash-webhook`.
JAZZCASH_RETURN_URL=

# --- Public app URL (payments-jazzcash-webhook's post-payment redirect) ------
# PUBLIC: the web client's own origin, no trailing slash — the customer's
# browser is sent back to `${PUBLIC_APP_URL}/premium?payment=success|failed`
# once JazzCash's callback has been verified.
PUBLIC_APP_URL=

# --- Web Push (engagement-nudge notifications — Blueprint §2.8/§4.6, ADR-019) --
# Generate once with `npx web-push generate-vapid-keys`. PUBLIC key ships to the
# web client's push-subscription call (once it exists); PRIVATE key signs the
# VAPID JWT server-side and must never reach a browser. SUBJECT is a mailto: or
# https: URL identifying the sender, per RFC 8292.
VAPID_SUBJECT=mailto:replace-with-a-real-contact-address@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Sentry (error reporting — Blueprint ADR-013, Phase 8) --------------------
# SECRET-ish: a write-only ingest endpoint, not a credential that reads
# anything back, but keep it out of client bundles anyway. Optional --
# _shared/observability/sentry.ts degrades to a silent no-op when unset, so
# nothing about local dev or CI requires a Sentry project to exist.
# Get this from Sentry → Project Settings → Client Keys (DSN) once a project
# exists.
SENTRY_DSN=

# --- PostHog (server-side business-event capture — Blueprint ADR-013, Phase 8) -
# SECRET-ish, same posture as SENTRY_DSN. Optional --
# _shared/observability/posthog.ts degrades to a silent no-op when unset.
# Captures only the handful of events the backend alone can see (a
# subscription being approved, an AI plan generated, an account deleted) --
# page views/funnels/session replay are frontend work for when the web
# client exists. Get the key from PostHog → Project Settings.
POSTHOG_API_KEY=
# One of the two ingest hosts PostHog's project settings state for this key.
# Defaults to the US host if unset.
POSTHOG_HOST=https://us.i.posthog.com

# --- Runtime -----------------------------------------------------------------
# One of: local | development | staging | production
APP_ENV=local

# One of: debug | info | warn | error
LOG_LEVEL=debug
