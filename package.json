{
  "name": "health-garden-app",
  "version": "0.1.0",
  "private": true,
  "description": "Pakistani-native health app: local-unit tracking, a permanent non-punitive garden progress mechanic, and a cost-capped AI coach. Web-first (Next.js PWA); React Native port gated behind retention data (ADR-019).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint --level warning",
    "test:db": "vitest run",
    "types:generate": "supabase gen types typescript --local > supabase/functions/_shared/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env.local",
    "test": "deno test --allow-env --allow-read --no-check=remote supabase/functions/",
    "test:watch": "deno test --allow-env --allow-read --no-check=remote --watch supabase/functions/",
    "test:coverage": "deno test --allow-env --allow-read --no-check=remote --coverage=.coverage supabase/functions/ && deno coverage .coverage",
    "typecheck": "deno check supabase/functions/**/*.ts && tsc --noEmit",
    "lint": "eslint . && deno lint supabase/functions/",
    "lint:fix": "eslint . --fix && deno lint --fix supabase/functions/",
    "format": "prettier --write . && deno fmt supabase/functions/",
    "format:check": "prettier --check . && deno fmt --check supabase/functions/",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@supabase/supabase-js": "^2.48.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "deno": "^2.1.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "supabase": "^2.6.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
